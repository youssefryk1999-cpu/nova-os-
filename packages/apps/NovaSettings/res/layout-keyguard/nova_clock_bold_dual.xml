<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nova_dual_clock_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp">

    <!-- Hours Row -->
    <TextView
        android:id="@+id/clock_hours"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="10"
        android:textSize="96sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:includeFontPadding="false"
        android:letterSpacing="-0.04" />

    <!-- Minutes Row (Accent Color Glow) -->
    <TextView
        android:id="@+id/clock_minutes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="45"
        android:textSize="96sp"
        android:textStyle="bold"
        android:textColor="#7C3AED"
        android:includeFontPadding="false"
        android:letterSpacing="-0.04"
        android:layout_marginTop="-20dp" />

    <!-- Date & Info Sub-Header -->
    <TextView
        android:id="@+id/clock_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sun, Nov 8"
        android:textSize="16sp"
        android:textColor="#A1A1AA"
        android:letterSpacing="0.05"
        android:layout_marginTop="8dp" />
</LinearLayout>
